# SPDX-License-Identifier: MIT
ARG ACT4_SEED=riscv-act4:ubuntu-24.04
ARG RUNTIME_BASE=public.ecr.aws/docker/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
FROM ${ACT4_SEED} AS export
USER root
COPY tools/prepare_profiles.py /tmp/prepare_profiles.py
RUN python3 /tmp/prepare_profiles.py
RUN mkdir -p /export/rootfs/opt/act4-cache \
    && cp -a /home/riscv/.cache/udb /export/rootfs/opt/act4-cache/udb

FROM ${RUNTIME_BASE} AS runtime
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git make device-tree-compiler libmpc3 libmpfr6 libgmp10 \
    libstdc++6 libexpat1 libyaml-0-2 libssl3t64 libffi8 zlib1g libzstd1 openssl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 riscv \
    && mkdir -p /act4 /artifacts /home/riscv/.cache \
    && chown -R riscv:riscv /act4 /artifacts /home/riscv
COPY --from=export /export/rootfs/ /
COPY act4.lock.json /usr/share/riscv-dev-env/act4.lock.json
COPY profiles/riscv_env.py /usr/local/lib/riscv_env.py
COPY profiles/bin/ /usr/local/bin/
COPY tools/seal_profiles.py /tmp/seal_profiles.py
RUN chmod 755 /usr/local/bin/riscv-act4-* \
    && chown riscv:riscv /home/riscv \
    && dpkg-query -W > /usr/share/riscv-dev-env/runtime-packages.txt \
    && /opt/act4-venv/bin/python3 /tmp/seal_profiles.py \
    && rm /tmp/seal_profiles.py
ENV HOME=/home/riscv VIRTUAL_ENV=/opt/act4-venv PYTHONDONTWRITEBYTECODE=1 \
    BUNDLE_FROZEN=true XDG_CACHE_HOME=/opt/act4-cache XDG_DATA_HOME=/tmp/act4-data
ENV PATH=/opt/act4-venv/bin:/opt/riscv/bin:/opt/spike-act4/bin:/opt/sail/bin:/home/riscv/.local/share/mise/installs/ruby/3.4.11/bin:$PATH
WORKDIR /act4
USER riscv
LABEL org.opencontainers.image.source="https://github.com/Gahao123/riscv-dev-env" \
    org.opencontainers.image.description="Ubuntu 24.04 ACT4 role prototype; RV64 I integration scope"
ENTRYPOINT ["riscv-act4-entry"]
CMD ["riscv-act4-run"]

FROM runtime AS ci
USER root
RUN printf 'ci\n' > /etc/riscv-act4-profile
USER riscv
LABEL org.opencontainers.image.title="ACT4 CI prototype" org.opencontainers.image.version="ubuntu-24.04-ci"

FROM runtime AS cert
USER root
RUN printf 'cert\n' > /etc/riscv-act4-profile
USER riscv
LABEL org.opencontainers.image.title="ACT4 fixed-input signing prototype" org.opencontainers.image.version="ubuntu-24.04-cert"

FROM runtime AS dev
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gdb-multiarch pkg-config curl vim-tiny \
    && rm -rf /var/lib/apt/lists/* \
    && printf 'dev\n' > /etc/riscv-act4-profile \
    && dpkg-query -W > /usr/share/riscv-dev-env/dev-packages.txt
USER riscv
LABEL org.opencontainers.image.title="ACT4 development prototype" org.opencontainers.image.version="ubuntu-24.04-dev"
CMD ["bash"]
